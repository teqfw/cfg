{
  "name": "@teqfw/cfg",
  "version": "2.0.0",
  "description": "Configuration package for Tequila Framework applications: load .env files and provide typed configuration through the DI container.",
  "keywords": [
    "configuration",
    "config",
    "env",
    "dotenv",
    "teqfw",
    "tequila framework"
  ],
  "homepage": "https://github.com/teqfw/cfg#readme",
  "bugs": {
    "url": "https://github.com/teqfw/cfg/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "files": [
    "skills/",
    "LICENSE",
    "src/",
    "CHANGELOG.md",
    "jsconfig.json",
    "README.md",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "type": "module",
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Cfg_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/cfg.git"
  },
  "scripts": {
    "test:unit": "node test/run-suite.mjs unit",
    "test:integration": "node test/run-suite.mjs integration",
    "test:acceptance": "node test/run-suite.mjs acceptance",
    "test:publish": "node test/run-suite.mjs publish",
    "test": "npm run test:unit && npm run test:integration && npm run test:acceptance && npm run test:publish",
    "typecheck": "tsc -p jsconfig.json",
    "lint:md": "markdownlint-cli2 \"skills/**/*.md\" \"*.md\""
  },
  "engines": {
    "node": ">=20"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  },
  "devDependencies": {
    "@teqfw/di": ">=2.9.0",
    "@teqfw/log": ">=2.0.0",
    "@types/node": "^26.1.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
